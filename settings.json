{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "mcp__github__pull_request_read",
      "mcp__github__issue_read",
      "mcp__github__list_pull_requests",
      "mcp__github__get_me",
      "mcp__github__search_users",
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(man *)",
      "Bash(date *)",
      "Bash(whoami *)",
      "Bash(hostname *)",
      "Bash(uname *)",
      "Bash(env *)",
      "Bash(mkdir *)",
      "Bash(printenv *)",
      "Bash(ps *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git init *)",
      "Bash(uv init *)",
      "Bash(uv sync *)",
      "Bash(uv add *)",
      "WebSearch",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:docs.isambard.ac.uk)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pypi.org)",
      "Bash(curl *)",
      "Bash(gh auth status *)",
      "Bash(gh repo view *)",
      "Bash(gh repo list *)",
      "Bash(gh api *)",
      "Bash(gh project *)",
      "Bash(gh label *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(module avail *)",
      "Bash(brew search *)",
      "Bash(brew info *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Read(~/.claude/**)",
      "Bash(terraform fmt *)",
      "Bash(terraform apply *)",
      "Bash(tmux *)"
    ],
    "deny": [
      "Bash(terraform apply -auto-approve *)",
      "Bash(terraform destroy *)",
      "Bash(gh * delete *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm *)",
      "Bash(mv /* *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(git commit --amend *)",
      "Bash(pip uninstall *)",
      "Bash(npm uninstall *)",
      "Bash(npm publish *)",
      "Bash(cargo publish *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown *)",
      "Bash(chown -R *)",
      "Bash(sudo *)",
      "Bash(curl * | bash *)",
      "Bash(wget * | bash *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(kill -9 *)",
      "Bash(pkill *)",
      "Bash(docker rm -f *)",
      "Bash(docker system prune *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/fedp-azureuser/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
